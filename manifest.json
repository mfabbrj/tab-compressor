{
  "manifest_version": 3,
  "name": "Tab Compressor / Limiter",
  "version": "1.0.0",
  "description": "Compressore e limiter per l'audio della scheda, con threshold, ratio, knee, attack, release, makeup e ceiling regolabili.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Compressore / Limiter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
